# API
XVA_DATABASE_URL=postgresql+psycopg://xva:xva@db:5432/xva
XVA_ADMIN_API_KEY=
XVA_CORS_ORIGINS=http://localhost:3000
XVA_LOG_LEVEL=INFO

# ECB Data Portal
XVA_ECB_BASE_URL=https://data-api.ecb.europa.eu/service
XVA_ECB_TIMEOUT_SECONDS=30
XVA_ECB_LOOKBACK_DAYS=7
XVA_ECB_MAX_STALENESS_DAYS=7

# PostgreSQL container
POSTGRES_DB=xva
POSTGRES_USER=xva
POSTGRES_PASSWORD=xva
