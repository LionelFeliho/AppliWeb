{
  "name": "XVA EOD Pricer Cloud Development",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "postCreateCommand": "bash scripts/codespace_setup.sh",
  "postStartCommand": "bash scripts/codespace_start.sh",
  "forwardPorts": [8000, 3000, 5432],
  "portsAttributes": {
    "8000": {
      "label": "XVA FastAPI / Swagger",
      "onAutoForward": "openBrowser"
    },
    "3000": {
      "label": "XVA Web Dashboard",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "XVA PostgreSQL",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    "PYTHONUNBUFFERED": "1",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "eamodio.gitlens",
        "github.vscode-github-actions"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["apps/api/tests"],
        "editor.formatOnSave": true,
        "files.exclude": {
          "**/__pycache__": true,
          "**/.pytest_cache": true
        }
      }
    }
  },
  "remoteUser": "vscode"
}
